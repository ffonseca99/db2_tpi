            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": \"{{dni_a}}\",\n  \"nombre\": \"Lucía\",\n  \"apellido\": \"Fernández\",\n  \"email\": \"lucía.fernández@example.com\",\n  \"telefono\": \"3511234567\",\n  \"membresia\": {\n    \"plan\": \"MENSUAL\",\n    \"precio\": 25000\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"dni_a\", String(Math.floor(10000000 + Math.random() * 89999999)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Nace activo y sin fechaBaja\", function () {",
                  "  const s = pm.response.json();",
                  "  pm.expect(s.activo).to.equal(true);",
                  "  pm.expect(s.fechaBaja).to.equal(null);",
                  "  pm.expect(s.fechaAlta).to.be.a(\"string\");",
                  "});",
