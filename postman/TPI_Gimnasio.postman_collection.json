    {
      "name": "2. Clases",
      "item": [
        {
          "name": "CREATE - Crear clase (cupo 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/clases",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "clases"
              ]
            },
            "description": "Una clase es UNA ocurrencia real: si hay boxeo hoy y mañana, son dos clases. fechaAlta la pone el servidor.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Boxeo\",\n  \"instructor\": {\n    \"nombre\": \"Martín Gómez\",\n    \"especialidad\": \"Boxeo\"\n  },\n  \"cupoMaximo\": 1,\n  \"sala\": \"Sala 1\",\n  \"fechaInicio\": \"{{fecha_inicio}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Inicio de la clase: dentro de 7 días, a hora en punto (UTC).",
                  "const inicio = new Date(Date.now() + 7 * 24 * 3600 * 1000);",
                  "inicio.setUTCMinutes(0, 0, 0);",
                  "pm.collectionVariables.set(\"fecha_inicio\", inicio.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Tiene fechaAlta y fechaInicio, y no tiene horarios\", function () {",
                  "  const c = pm.response.json();",
                  "  pm.expect(c.fechaAlta).to.be.a(\"string\");",
                  "  pm.expect(c.fechaInicio).to.be.a(\"string\");",
                  "  pm.expect(c).to.not.have.property(\"horarios\");",
                  "  pm.expect(c.activo).to.equal(true);",
                  "});",
                  "pm.collectionVariables.set(\"clase_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
